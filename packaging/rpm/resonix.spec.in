# Source RPM definition for Resonix.
# The release profile strips the binary, so there is no debug information to
# split out.
%global debug_package %{nil}

Name:           resonix
Version:        @VERSION@
Release:        1%{?dist}
Summary:        Native YouTube Music client

License:        MIT
URL:            https://github.com/ItsARCn/Resonix
Source0:        https://github.com/ItsARCn/Resonix/releases/download/v%{version}/resonix-v%{version}-source.tar.gz
# Every crate Cargo.lock names, from `cargo vendor`, with the Cargo
# configuration that points the build at it.
Source1:        resonix-%{version}-vendor.tar.xz

ExclusiveArch:  x86_64 aarch64

BuildRequires:  rust >= @RUST_VERSION@
BuildRequires:  cargo
BuildRequires:  gcc
BuildRequires:  gcc-c++
# MilkDrop: projectm-sys builds libprojectM with CMake and binds it with
# bindgen, which needs libclang.
BuildRequires:  cmake
BuildRequires:  clang
BuildRequires:  clang-devel
BuildRequires:  pkgconfig(alsa)
BuildRequires:  pkgconfig(libpipewire-0.3)
BuildRequires:  pkgconfig(xkbcommon)
BuildRequires:  pkgconfig(wayland-client)
BuildRequires:  pkgconfig(gl)

# The window, input and GL libraries are loaded at run time, so ELF
# dependency generation does not find them. Keep these aligned with the
# rpm list in native-packages.yaml.
Requires:       dbus-libs
Requires:       libglvnd-glx
Requires:       libglvnd-egl
Requires:       libxkbcommon
Requires:       libxkbcommon-x11
Requires:       libwayland-client
Requires:       libwayland-cursor
Requires:       libwayland-egl
Requires:       libX11
Requires:       libX11-xcb
Requires:       libXcursor
Requires:       libXi
Requires:       libXrandr
Requires:       hicolor-icon-theme
Requires:       yt-dlp
Requires:       ffmpeg-free

%description
Resonix is a small native YouTube Music client for Linux, macOS and Windows. It
plays through YouTube/YouTube Music, with a Winamp mini player, synced lyrics,
Discord Rich Presence, and MilkDrop visuals.

%prep
%autosetup -n Resonix-%{version}
tar -xf %{SOURCE1}
cat vendor-config.toml >> .cargo/config.toml

%build
# projectm-sys links libprojectM from its CMake install's lib/, and CMake
# installs to lib64/ on Fedora unless told otherwise. CMake reads this
# toolchain file from the environment.
printf 'set(CMAKE_INSTALL_LIBDIR lib CACHE PATH "")\n' > %{_builddir}/libdir.cmake
export CMAKE_TOOLCHAIN_FILE=%{_builddir}/libdir.cmake
cargo build --frozen --release

%check
./target/release/resonix --version | grep -Fx 'resonix %{version}'

%install
install -Dpm0755 target/release/resonix %{buildroot}%{_bindir}/resonix
install -Dpm0644 packaging/applications/resonix.desktop %{buildroot}%{_datadir}/applications/resonix.desktop
install -Dpm0644 packaging/icons/resonix.svg %{buildroot}%{_datadir}/icons/hicolor/scalable/apps/resonix.svg
install -Dpm0644 contrib/omarchy/resonix.json.tpl %{buildroot}%{_datadir}/resonix/omarchy/resonix.json.tpl
install -Dpm0755 contrib/omarchy/resonix-theme %{buildroot}%{_datadir}/resonix/omarchy/resonix-theme

%files
%license LICENSE
%doc README.md
%{_bindir}/resonix
%{_datadir}/applications/resonix.desktop
%{_datadir}/icons/hicolor/scalable/apps/resonix.svg
%{_datadir}/resonix/

%changelog
* @RPM_DATE@ ItsARCn - @VERSION@-1
- Update to @VERSION@
